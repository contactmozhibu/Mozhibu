<td style="border:1px solid #ddd;">Update chapter</td>
</tr>
<tr>
<td style="border:1px solid #ddd;">DELETE</td>
<td style="border:1px solid #ddd;"><code>/books/:bookId/chapters/:chapterId</code></td>
<td style="border:1px solid #ddd;">Writer</td>
<td style="border:1px solid #ddd;">Delete chapter</td>
</tr>
</tbody></table>
